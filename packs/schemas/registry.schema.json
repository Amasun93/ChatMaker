{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatmaker.dev/schemas/registry.schema.json",
  "title": "ChatMaker official pack registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence", "generated_at", "expires_at", "packs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sequence": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "packs": {
      "type": "array",
      "maxItems": 6,
      "items": {"$ref": "#/$defs/pack"}
    }
  },
  "$defs": {
    "packId": {
      "enum": [
        "chatmaker-board-arduino-nano-classic-knowledge",
        "chatmaker-board-arduino-uno-r3-knowledge",
        "chatmaker-board-esp32-devkit-v1-knowledge",
        "chatmaker-board-idmc-0001-starcore-v4-2-2-knowledge",
        "chatmaker-board-mpython-classic-v2x-knowledge",
        "chatmaker-board-mpython-v3-knowledge"
      ]
    },
    "coreCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum_exclusive"],
      "properties": {
        "minimum": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "maximum_exclusive": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "pack_manifest_schema", "knowledge_index_schema"],
      "properties": {
        "core": {"$ref": "#/$defs/coreCompatibility"},
        "pack_manifest_schema": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "1.0"}},
        "knowledge_index_schema": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "1.0"}}
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_id", "pack_type", "version", "board_id", "url", "length", "sha256", "compatibility"],
      "properties": {
        "pack_id": {"$ref": "#/$defs/packId"},
        "pack_type": {"const": "knowledge"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "board_id": {"enum": ["arduino-nano-classic", "arduino-uno-r3", "esp32-devkit-v1", "idmc-0001-starcore-v4-2-2", "mpython-classic-v2x", "mpython-v3"]},
        "url": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/Amasun93/ChatMaker/[0-9a-f]{40}/distribution/packs/chatmaker-board-(?:arduino-nano-classic|arduino-uno-r3|esp32-devkit-v1|idmc-0001-starcore-v4-2-2|mpython-classic-v2x|mpython-v3)-knowledge-[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\.cmpack$"
        },
        "length": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compatibility": {"$ref": "#/$defs/compatibility"}
      },
      "allOf": [
        {
          "if": {"properties": {"board_id": {"const": "arduino-nano-classic"}}},
          "then": {"properties": {"pack_id": {"const": "chatmaker-board-arduino-nano-classic-knowledge"}}}
        },
        {
          "if": {"properties": {"board_id": {"const": "arduino-uno-r3"}}},
          "then": {"properties": {"pack_id": {"const": "chatmaker-board-arduino-uno-r3-knowledge"}}}
        },
        {
          "if": {"properties": {"board_id": {"const": "esp32-devkit-v1"}}},
          "then": {"properties": {"pack_id": {"const": "chatmaker-board-esp32-devkit-v1-knowledge"}}}
        },
        {
          "if": {"properties": {"board_id": {"const": "idmc-0001-starcore-v4-2-2"}}},
          "then": {"properties": {"pack_id": {"const": "chatmaker-board-idmc-0001-starcore-v4-2-2-knowledge"}}}
        },
        {
          "if": {"properties": {"board_id": {"const": "mpython-classic-v2x"}}},
          "then": {"properties": {"pack_id": {"const": "chatmaker-board-mpython-classic-v2x-knowledge"}}}
        },
        {
          "if": {"properties": {"board_id": {"const": "mpython-v3"}}},
          "then": {"properties": {"pack_id": {"const": "chatmaker-board-mpython-v3-knowledge"}}}
        }
      ]
    },
    "detachedSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "signature"],
      "properties": {
        "key_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "algorithm": {"const": "ed25519"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$"}
      }
    }
  }
}

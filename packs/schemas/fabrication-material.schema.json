{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatmaker.dev/schemas/fabrication-material-1.0.json",
  "title": "ChatMaker fabrication material profile",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "material_id",
    "name",
    "material_family",
    "default_thickness_mm",
    "thickness_adjustable",
    "recommended_for",
    "kerf",
    "machine_parameters",
    "source_ids",
    "verification"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "fabrication-material-profile"},
    "material_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "material_family": {"type": "string", "minLength": 1},
    "default_thickness_mm": {"type": "number", "exclusiveMinimum": 0},
    "thickness_adjustable": {"type": "boolean"},
    "recommended_for": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "kerf": {
      "type": "object",
      "required": ["status", "value_mm"],
      "properties": {
        "status": {"type": "string"},
        "value_mm": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    },
    "machine_parameters": {
      "type": "object",
      "required": ["status", "power", "speed", "passes"],
      "properties": {
        "status": {"const": "calibration-required"},
        "power": {"type": ["number", "null"]},
        "speed": {"type": ["number", "null"]},
        "passes": {"type": ["integer", "null"]}
      },
      "additionalProperties": false
    },
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "verification": {"type": "object"}
  },
  "additionalProperties": false
}

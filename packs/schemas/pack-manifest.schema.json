{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatmaker.dev/schemas/pack-manifest.schema.json",
  "title": "ChatMaker passive knowledge-pack manifest",
  "x-chatmaker-semantic-constraints": {
    "unique_file_paths": {
      "comparison": "unicode_codepoint_exact",
      "error_code": "pack_manifest_invalid",
      "reason": "duplicate_path"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format_version", "pack_id", "pack_version", "pack_type", "board_id", "compatibility", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "format_version": {"const": 1},
    "pack_id": {
      "enum": [
        "chatmaker-board-arduino-nano-classic-knowledge",
        "chatmaker-board-arduino-uno-r3-knowledge",
        "chatmaker-board-esp32-devkit-v1-knowledge",
        "chatmaker-board-idmc-0001-starcore-v4-2-2-knowledge",
        "chatmaker-board-mpython-classic-v2x-knowledge",
        "chatmaker-board-mpython-v3-knowledge"
      ]
    },
    "pack_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "pack_type": {"const": "knowledge"},
    "board_id": {"enum": ["arduino-nano-classic", "arduino-uno-r3", "esp32-devkit-v1", "idmc-0001-starcore-v4-2-2", "mpython-classic-v2x", "mpython-v3"]},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 65,
      "uniqueItems": true,
      "contains": {
        "type": "object",
        "properties": {"path": {"const": "knowledge/index.yaml"}},
        "required": ["path"]
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "length", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^knowledge/(?:index\\.yaml|sections/[a-z0-9][a-z0-9-]*\\.md)$"},
          "length": {"type": "integer", "minimum": 1, "maximum": 69632},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "knowledge_index_schema"],
      "properties": {
        "core": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum_exclusive"],
          "properties": {
            "minimum": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "maximum_exclusive": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
          }
        },
        "knowledge_index_schema": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"const": "1.0"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"board_id": {"const": "arduino-nano-classic"}}},
      "then": {"properties": {"pack_id": {"const": "chatmaker-board-arduino-nano-classic-knowledge"}}}
    },
    {
      "if": {"properties": {"board_id": {"const": "arduino-uno-r3"}}},
      "then": {"properties": {"pack_id": {"const": "chatmaker-board-arduino-uno-r3-knowledge"}}}
    },
    {
      "if": {"properties": {"board_id": {"const": "esp32-devkit-v1"}}},
      "then": {"properties": {"pack_id": {"const": "chatmaker-board-esp32-devkit-v1-knowledge"}}}
    },
    {
      "if": {"properties": {"board_id": {"const": "idmc-0001-starcore-v4-2-2"}}},
      "then": {"properties": {"pack_id": {"const": "chatmaker-board-idmc-0001-starcore-v4-2-2-knowledge"}}}
    },
    {
      "if": {"properties": {"board_id": {"const": "mpython-classic-v2x"}}},
      "then": {"properties": {"pack_id": {"const": "chatmaker-board-mpython-classic-v2x-knowledge"}}}
    },
    {
      "if": {"properties": {"board_id": {"const": "mpython-v3"}}},
      "then": {"properties": {"pack_id": {"const": "chatmaker-board-mpython-v3-knowledge"}}}
    }
  ]
}

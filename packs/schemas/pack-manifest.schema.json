{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatmaker.dev/schemas/pack-manifest.schema.json",
  "title": "ChatMaker passive knowledge-pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format_version", "pack_id", "pack_version", "pack_type", "board_id", "compatibility", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "format_version": {"const": 1},
    "pack_id": {
      "enum": [
        "chatmaker-board-arduino-nano-classic-wiki",
        "chatmaker-board-arduino-uno-r3-wiki",
        "chatmaker-board-esp32-devkit-v1-wiki"
      ]
    },
    "pack_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "pack_type": {"const": "knowledge"},
    "board_id": {"enum": ["arduino-nano-classic", "arduino-uno-r3", "esp32-devkit-v1"]},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 65,
      "contains": {
        "type": "object",
        "properties": {"path": {"const": "llmwiki/index.yaml"}},
        "required": ["path"]
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "length", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^llmwiki/(?:index\\.yaml|sections/[a-z0-9][a-z0-9-]*\\.md)$"},
          "length": {"type": "integer", "minimum": 1, "maximum": 65536},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "llmwiki_index_schema"],
      "properties": {
        "core": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum_exclusive"],
          "properties": {
            "minimum": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "maximum_exclusive": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
          }
        },
        "llmwiki_index_schema": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"const": "1.0"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"board_id": {"const": "arduino-nano-classic"}}},
      "then": {"properties": {"pack_id": {"const": "chatmaker-board-arduino-nano-classic-wiki"}}}
    },
    {
      "if": {"properties": {"board_id": {"const": "arduino-uno-r3"}}},
      "then": {"properties": {"pack_id": {"const": "chatmaker-board-arduino-uno-r3-wiki"}}}
    },
    {
      "if": {"properties": {"board_id": {"const": "esp32-devkit-v1"}}},
      "then": {"properties": {"pack_id": {"const": "chatmaker-board-esp32-devkit-v1-wiki"}}}
    }
  ]
}

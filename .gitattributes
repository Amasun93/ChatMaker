# Canonical repository text bytes. Signed registries and deterministic pack
# inputs are read as bytes, so every text checkout must retain LF line endings.
* text=auto eol=lf

# Published pack archives are byte-exact binary artifacts.
*.cmpack -text

# Preserve the exact bytes of compiled ChatSim demo programs.
runtime/chatmaker/sim_assets/*.hex binary
runtime/chatmaker/sim_assets/*.wasm binary

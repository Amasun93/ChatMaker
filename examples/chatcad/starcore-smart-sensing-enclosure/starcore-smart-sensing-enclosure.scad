// ChatMaker Chat3D V1 - starcore-smart-sensing-enclosure
// 盒体中心为 XY 原点、Z 向上，单位 mm。
/* [输出] */
part = "assembled"; // [assembled,base,lid]

/* [内腔尺寸] */
inner_width = 200.0; // 内腔宽度 (mm)
inner_depth = 150.0; // 内腔深度 (mm)
inner_height = 45.0; // 内腔高度 (mm)

/* [壁厚] */
wall = 2.4; // 侧壁厚 (mm)
floor = 2.4; // 底板厚 (mm)
lid = 2.0; // 上盖厚 (mm)

/* [安装柱] */
standoff_height = 5.0; // 安装柱高度 (mm)
hole_diameter = 2.8; // 安装孔直径 (mm)
lid_hole_diameter = 3.6; // 顶盖 M3 通孔校准起点 (mm)
opening_clearance = 0.4; // 功能开口单边余量 (mm)

/* [文字雕刻] */
show_label = true; // 显示中文文字（改文字内容需回到 ChatCAD 重新生成）
label_depth = 0.8; // 文字浮凸深度 (mm)
label_scale = 1.0; // 文字缩放
label_x = 0; // 文字水平偏移 (mm)
label_y = 0; // 文字垂直偏移 (mm)

/* [侧边线束出口 1] */
wire_exit_1_face = "front"; // [none,front,back,left,right]
wire_exit_1_position = 0.0; // 前/后板为 X，左/右板为 Y (mm)
wire_exit_1_z = 10.0; // 相对内腔底面的中心高度 (mm)
wire_exit_1_width = 22.0; // 名义宽度 (mm)
wire_exit_1_height = 9.0; // 名义高度 (mm)
wire_exit_1_clearance = 0.4; // 单边余量 (mm)

$fn = 64;
base_mount_points = [[-40.0,-1.2551659999999991],[40.0,-1.2551659999999991],[40.0,40.744834],[-40.0,40.744834]];
lid_mount_points = [[-77.5,20.0],[-32.5,20.0],[-32.5,40.0],[-77.5,40.0],[22.5,20.0],[67.5,20.0],[67.5,40.0],[22.5,40.0],[-10.0,-45.0],[10.0,-45.0],[10.0,-25.0],[-10.0,-25.0]];

module side_opening_cutout(face, position, z, width, height, clearance){
  cut_width = width + 2*clearance;
  cut_height = height + 2*clearance;
  if (face == "front")
    translate([wall+inner_width/2+position-cut_width/2, -.1, floor+z-cut_height/2])
      cube([cut_width, wall+.2, cut_height]);
  if (face == "back")
    translate([wall+inner_width/2+position-cut_width/2, wall+inner_depth-.1, floor+z-cut_height/2])
      cube([cut_width, wall+.2, cut_height]);
  if (face == "left")
    translate([-.1, wall+inner_depth/2-position-cut_width/2, floor+z-cut_height/2])
      cube([wall+.2, cut_width, cut_height]);
  if (face == "right")
    translate([wall+inner_width-.1, wall+inner_depth/2-position-cut_width/2, floor+z-cut_height/2])
      cube([wall+.2, cut_width, cut_height]);
}

module base_part(){
  difference(){
    cube([inner_width+2*wall, inner_depth+2*wall, inner_height+floor]);
    translate([wall,wall,floor]) cube([inner_width, inner_depth, inner_height+1]);
    side_opening_cutout(wire_exit_1_face, wire_exit_1_position, wire_exit_1_z, wire_exit_1_width, wire_exit_1_height, wire_exit_1_clearance);
  }
  for(p=base_mount_points)
    translate([wall+inner_width/2+p[0], wall+inner_depth/2-p[1], floor])
      difference(){
        cylinder(h=standoff_height, d=hole_diameter+3);
        translate([0,0,-.1]) cylinder(h=standoff_height+.2, d=hole_diameter);
      }
}
module lid_cutouts(){
  for(p=lid_mount_points)
    translate([wall+inner_width/2+p[0], wall+inner_depth/2-p[1], -.1])
      cylinder(h=lid+.2, d=lid_hole_diameter);
  translate([wall+inner_width/2+-55.0, wall+inner_depth/2-30.0, lid/2]) rotate([0,0,-0.0]) cube([37.0+2*opening_clearance, 25.0+2*opening_clearance, lid+.2], center=true); // idmd-0021-starcore-oled-1-3
  translate([wall+inner_width/2+32.2375, wall+inner_depth/2-30.0, -.1]) cylinder(h=lid+.2, d=15.8+2*opening_clearance); // idms-0009-starcore-ultrasonic
  translate([wall+inner_width/2+57.7625, wall+inner_depth/2-30.0, -.1]) cylinder(h=lid+.2, d=15.8+2*opening_clearance); // idms-0009-starcore-ultrasonic
  translate([wall+inner_width/2+0.0, wall+inner_depth/2--34.761, lid/2]) rotate([0,0,-0.0]) cube([17.0+2*opening_clearance, 14.0+2*opening_clearance, lid+.2], center=true); // idms-0008-starcore-dht11
}
module cover_part(){difference(){cube([inner_width+2*wall, inner_depth+2*wall, lid]);lid_cutouts();}}

